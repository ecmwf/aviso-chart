          "expr": "sum(rate(aviso_ecpds_cache_hits_total[$__rate_interval])) / (sum(rate(aviso_ecpds_cache_hits_total[$__rate_interval])) + sum(rate(aviso_ecpds_cache_misses_total[$__rate_interval])))",
          "legendFormat": "hit ratio",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "aviso_ecpds_cache_size",
          "legendFormat": "entries",
          "range": true
        }
      ],
      "description": "Hit ratio (0-1) and cached usernames. deny_destination retries hit the cache: decisions climb while fetches stay flat."
    },
    {
      "type": "timeseries",
      "title": "ECPDS upstream fetches",
      "id": 20,
      "datasource": {
        "type": "prometheus",
